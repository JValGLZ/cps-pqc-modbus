diff --git a/wolfssl/wolfcrypt/asn.h b/wolfssl/wolfcrypt/asn.h
index 24d8362c8b..58184c4a3a 100644
--- a/wolfssl/wolfcrypt/asn.h
+++ b/wolfssl/wolfcrypt/asn.h
@@ -922,7 +922,15 @@ enum Misc_ASN {
     MIN_DATE_SIZE       =  12,
     MAX_DATE_SIZE       =  32,
     ASN_GEN_TIME_SZ     =  15,     /* 7 numbers * 2 + Zulu tag */
-#ifndef NO_RSA
+#if defined(HAVE_DILITHIUM)
+    /* wolfSSL's classical-key sizing below (RSA/ECC/Curve448) never
+     * accounted for post-quantum signatures. Dilithium5's raw signature
+     * is 4595 bytes, far past the 512-1024 bytes sized for RSA up to
+     * 8192 bits. Give Dilithium priority here when compiled in -- this
+     * literal (not a dilithium.h constant) avoids a header include
+     * cycle, since dilithium.h itself depends on asn.h/asn_public.h. */
+    MAX_ENCODED_SIG_SZ  = 4595,    /* Dilithium5 raw signature size */
+#elif !defined(NO_RSA)
 #ifdef WOLFSSL_HAPROXY
     MAX_ENCODED_SIG_SZ  = 1024,    /* Supports 8192 bit keys */
 #else
